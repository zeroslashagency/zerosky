# zerosky — environment template
#
# Copy to `.env` (and/or `apps/<app>/.env.local`) and fill in real values.
# EVERY VALUE BELOW IS A PLACEHOLDER. Never commit real secrets.

# ─────────────────────────────────────────────────────────────
# Data stores
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma (@zerosky/database).
DATABASE_URL="postgresql://zerosky:zerosky@localhost:5432/zerosky?schema=public"

# Redis, used for session storage and revocation.
# REQUIRED in production: without it sessions cannot be revoked or shared
# between processes. In development a missing value falls back to an in-memory
# store and logs a warning.
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────
# Session signing
# ─────────────────────────────────────────────────────────────

# Secret used to sign access tokens. REQUIRED in production — the process
# refuses to start without it and there is no hardcoded fallback. Must be at
# least 32 characters. Generate one with:
#
#   openssl rand -hex 32
#
# In development a missing value produces an EPHEMERAL random secret (every
# session dies on restart) and logs a warning.
JWT_SECRET="replace-me-with-openssl-rand-hex-32"

# Optional: secret for refresh tokens. When unset it is derived from JWT_SECRET,
# guaranteeing the two differ so a refresh token can never act as an access
# token. Set it explicitly to rotate refresh tokens independently.
#   openssl rand -hex 32
# JWT_REFRESH_SECRET=""

# Optional token lifetimes (seconds). Defaults: 900 (15m) / 604800 (7d).
# JWT_ACCESS_TTL_SECONDS="900"
# JWT_REFRESH_TTL_SECONDS="604800"

# Optional issuer claim. Defaults to "zerosky".
# JWT_ISSUER="zerosky"

# ─────────────────────────────────────────────────────────────
# Web apps (apps/pos-web, apps/kds-display)
# ─────────────────────────────────────────────────────────────

# tRPC endpoint. The session cookie is httpOnly + SameSite=Lax, so this must be
# SAME-ORIGIN with the app or the cookie is not sent and every call 401s. Each
# app hosts its own /api/trpc route, so the relative path is the safe default;
# a cross-origin value is ignored in the browser with a console warning.
NEXT_PUBLIC_API_URL="/api/trpc"

# Tenant slug this terminal/display is installed for. Must match a seeded
# Tenant.slug or login fails with "Invalid tenant".
NEXT_PUBLIC_TENANT_SLUG="zerosky-demo"

# ─────────────────────────────────────────────────────────────
# Seeding (development only)
# ─────────────────────────────────────────────────────────────

# Password given to every seeded dev account. Change it for any shared
# environment. PINs are seeded as bcrypt hashes.
SEED_PASSWORD="change-me-locally"

# ─────────────────────────────────────────────────────────────
# Payments — Razorpay (@zerosky/payments)
# ─────────────────────────────────────────────────────────────

# Test keys look like rzp_test_xxxxxxxxxxxx; live keys rzp_live_xxxxxxxxxxxx.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-me"

# Secret configured on the Razorpay webhook endpoint; used to verify signatures.
RAZORPAY_WEBHOOK_SECRET="replace-me"

# Public key id for the browser checkout widget (safe to expose; the secret is not).
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_me"

# ─────────────────────────────────────────────────────────────
# Rate limiting (optional overrides)
# ─────────────────────────────────────────────────────────────

# General per-client budget and window. Defaults: 1000 requests / 60000 ms.
# API_RATE_LIMIT="1000"
# API_RATE_LIMIT_WINDOW_MS="60000"

# Tighter budget for sign-in attempts. Defaults: 10 attempts / 60000 ms.
# API_AUTH_RATE_LIMIT="10"
# API_AUTH_RATE_LIMIT_WINDOW_MS="60000"

# ─────────────────────────────────────────────────────────────
# Printing — ESC/POS thermal printers (@zerosky/print)
# ─────────────────────────────────────────────────────────────

# Printer transport: "mock" (default, no hardware), "network", or "usb" (not yet implemented).
# Mock mode always succeeds; use it in dev/CI where no physical printer exists.
PRINTER_TRANSPORT="mock"

# Network printer settings (only used when PRINTER_TRANSPORT=network).
# PRINTER_HOST="192.168.1.100"
# PRINTER_PORT="9100"

# Paper width in mm: 58 or 80. Controls column count (32 for 58mm, 48 for 80mm). Defaults to 80.
# PRINTER_WIDTH="80"

# Comma-separated list of IPs to probe during printer discovery (listPrinters).
# PRINTER_NETWORK_SCAN_HOSTS="192.168.1.100,192.168.1.101,192.168.1.102"

