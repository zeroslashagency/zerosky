{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET", "NEXT_PUBLIC_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET", "NEXT_PUBLIC_*", "VERCEL*", "NEXT_RUNTIME"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "db:generate": {
      "cache": false,
      "outputs": ["generated/**"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": ["coverage/**", ".coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": ["coverage/**", ".coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "clean": {
      "cache": false
    }
  }
}
