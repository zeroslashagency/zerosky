// zerosky — restaurant POS data model
// Multi-tenant (Tenant → Branch), menu → order → KOT → payment lifecycle.
// Studied from OSS workflows (URY, ahmedali5530, satisfecho, FloCafe);
// schema and names are original to zerosky.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum TableState {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILLED
  CLEANING
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  AGGREGATOR
}

enum OrderStatus {
  OPEN
  SENT_TO_KITCHEN
  READY
  SERVED
  BILLED
  PAID
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum KotStatus {
  NEW
  MODIFIED
  PARTIAL
  READY
  SERVED
  CANCELLED
}

/// How a discount was expressed when it was applied. The resolved rupee amount
/// always lands in discountTotal; this records the operator's intent so reports
/// can tell "10% off" apart from "₹50 off".
enum DiscountType {
  PERCENT
  FLAT
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  AGGREGATOR
  COMPLIMENTARY
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  gstin     String? // GST registration number
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches         Branch[]
  users            User[]
  menus            Menu[]
  inventoryItems   InventoryItem[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  stockAdjustments StockAdjustment[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String // short code, unique per tenant
  address   String?
  phone     String?
  gstin     String?
  timezone  String   @default("Asia/Kolkata")
  currency  String   @default("INR")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables   Table[]
  orders   Order[]
  payments Payment[]
  shifts   Shift[]
  partners BranchPartner[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         UserRole @default(CASHIER)
  // bcrypt hash of the quick POS login PIN. Never store the PIN itself: a
  // plaintext column meant a database read handed over working credentials.
  pinHash      String?  @map("pin_hash")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdOrders    Order[]           @relation("OrderCreatedBy")
  discountedOrders Order[]           @relation("OrderDiscountBy")
  openedShifts     Shift[]           @relation("ShiftOpenedBy")
  closedShifts     Shift[]           @relation("ShiftClosedBy")
  purchaseOrders   PurchaseOrder[]
  stockAdjustments StockAdjustment[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Menu
// ─────────────────────────────────────────────────────────────

model Menu {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories Category[]

  @@index([tenantId])
  @@map("menus")
}

model Category {
  id        String   @id @default(cuid())
  menuId    String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu  Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items Item[]

  @@index([menuId])
  @@map("categories")
}

model Item {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  taxRate     Decimal  @default(5.0) @db.Decimal(5, 2) // GST %
  isVeg       Boolean  @default(true)
  sku         String?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@map("items")
}

model ModifierGroup {
  id         String   @id @default(cuid())
  itemId     String
  name       String // e.g. "Spice level", "Add-ons"
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  isRequired Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  modifiers Modifier[]

  @@index([itemId])
  @@map("modifier_groups")
}

model Modifier {
  id              String   @id @default(cuid())
  modifierGroupId String
  name            String
  price           Decimal  @default(0) @db.Decimal(10, 2)
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
  @@map("modifiers")
}

// ─────────────────────────────────────────────────────────────
// Floor
// ─────────────────────────────────────────────────────────────

model Table {
  id        String     @id @default(cuid())
  branchId  String
  name      String // "T1", "Patio 3"
  section   String? // "Main hall", "Rooftop"
  seats     Int        @default(4)
  state     TableState @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("tables")
}

// ─────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────

model Order {
  id            String      @id @default(cuid())
  branchId      String
  tableId       String?
  createdById   String?
  shiftId       String?
  orderNumber   String // human-readable, unique per branch
  type          OrderType   @default(DINE_IN)
  status        OrderStatus @default(OPEN)
  guestCount    Int         @default(1)
  subtotal      Decimal     @default(0) @db.Decimal(10, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(10, 2)
  discountTotal Decimal     @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal     @default(0) @db.Decimal(10, 2)

  /// How discountTotal was arrived at. Stored so a bill can be reprinted months
  /// later and still explain itself, and so a discount report can group by
  /// reason. PERCENT keeps the percentage in discountValue; FLAT keeps rupees.
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(10, 2)
  discountReason String?
  discountById   String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table      Table?      @relation(fields: [tableId], references: [id])
  createdBy  User?       @relation("OrderCreatedBy", fields: [createdById], references: [id])
  discountBy User?       @relation("OrderDiscountBy", fields: [discountById], references: [id])
  shift      Shift?      @relation(fields: [shiftId], references: [id])
  items      OrderItem[]
  kots       Kot[]
  payments   Payment[]

  @@unique([branchId, orderNumber])
  @@index([branchId])
  @@index([tableId])
  @@index([createdById])
  @@index([status])
  // Reports filter by branch over a date window; this composite serves
  // salesSummary, dailySales and gstReport without a sequential scan.
  @@index([branchId, createdAt])
  // The order list and billing queue filter by branch plus status.
  @@index([branchId, status])
  // The shift report and shift close sum the orders belonging to one shift.
  @@index([shiftId])
  @@map("orders")
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  itemId         String
  kotId          String?
  name           String // snapshot of item name at order time
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(10, 2)
  taxRate        Decimal         @db.Decimal(5, 2)
  lineTotal      Decimal         @db.Decimal(10, 2)
  /// Rupees taken off this line. lineTotal is already net of it, so the bill and
  /// the amount charged cannot drift apart.
  discountAmount Decimal         @default(0) @db.Decimal(10, 2)
  seat           Int? // for seat-split billing
  modifiers      Json? // snapshot: [{ name, price }]
  notes          String?
  status         OrderItemStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id])
  kot   Kot?  @relation(fields: [kotId], references: [id])

  @@index([orderId])
  @@index([itemId])
  @@index([kotId])
  @@map("order_items")
}

model Kot {
  id        String    @id @default(cuid())
  orderId   String
  kotNumber String
  station   String? // "Tandoor", "Bar", "Cold kitchen"
  status    KotStatus @default(NEW)
  printedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@unique([orderId, kotNumber])
  @@index([orderId])
  @@index([status])
  // The KDS polls open tickets for one station.
  @@index([station, status])
  @@map("kots")
}

// ─────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────

/// A cashier's till session. Billing is gated on an open shift so every order
/// and payment is attributable to a countable drawer, and closing records what
/// was actually counted against what the system expected. The difference is the
/// variance an owner reviews — that is the whole point of the model.
model Shift {
  id         String      @id @default(cuid())
  branchId   String
  openedById String
  closedById String?
  status     ShiftStatus @default(OPEN)

  /// Float placed in the drawer at open.
  openingCash  Decimal  @db.Decimal(10, 2)
  /// Physically counted at close. Null until then.
  closingCash  Decimal? @db.Decimal(10, 2)
  /// What the system believes should be in the drawer: opening + cash sales
  /// - cash refunds. Snapshotted at close so later edits cannot rewrite history.
  expectedCash Decimal? @db.Decimal(10, 2)
  /// closingCash - expectedCash. Negative means the drawer is short.
  variance     Decimal? @db.Decimal(10, 2)

  openedAt DateTime  @default(now())
  closedAt DateTime?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedBy User   @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy User?  @relation("ShiftClosedBy", fields: [closedById], references: [id])

  orders   Order[]
  payments Payment[]

  @@index([branchId])
  @@index([openedById])
  // Opening a shift must check that no other shift is already open for the
  // branch, and the shift report filters by branch over a date window.
  @@index([branchId, status])
  @@index([branchId, openedAt])
  @@map("shifts")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Payment {
  id         String        @id @default(cuid())
  branchId   String
  orderId    String
  shiftId    String?
  method     PaymentMethod
  status     PaymentStatus @default(PENDING)
  amount     Decimal       @db.Decimal(10, 2)
  reference  String? // gateway txn id / UPI ref
  tenderedAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shift  Shift? @relation(fields: [shiftId], references: [id])

  @@index([branchId])
  @@index([orderId])
  // Payment-method breakdown groups by method over a branch/date window.
  @@index([branchId, method, tenderedAt])
  // Closing a shift sums its cash payments.
  @@index([shiftId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// Inventory Management
// ─────────────────────────────────────────────────────────────

model InventoryItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  sku      String? @unique
  category String
  unit     String // e.g., "kg", "pieces", "liters"

  currentStock  Decimal  @default(0) @db.Decimal(10, 2)
  minStockLevel Decimal  @default(0) @db.Decimal(10, 2)
  maxStockLevel Decimal? @db.Decimal(10, 2)
  reorderPoint  Decimal? @db.Decimal(10, 2)

  unitCost Decimal @default(0) @db.Decimal(10, 2)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockAdjustments   StockAdjustment[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([tenantId])
  @@index([supplierId])
  @@map("inventory_items")
}

model Supplier {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderNumber String   @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])

  status String @default("DRAFT") // DRAFT, SENT, RECEIVED, CANCELLED

  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  receivedDate DateTime?

  totalAmount Decimal @default(0) @db.Decimal(10, 2)
  notes       String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  quantity  Decimal @db.Decimal(10, 2)
  unitCost  Decimal @db.Decimal(10, 2)
  totalCost Decimal @db.Decimal(10, 2)

  receivedQuantity Decimal? @db.Decimal(10, 2)

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
  @@map("purchase_order_items")
}

model StockAdjustment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  type          String // "IN", "OUT", "ADJUSTMENT", "WASTAGE"
  quantity      Decimal @db.Decimal(10, 2)
  previousStock Decimal @db.Decimal(10, 2)
  newStock      Decimal @db.Decimal(10, 2)

  reason String?
  notes  String?

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([inventoryItemId])
  @@map("stock_adjustments")
}

// ─────────────────────────────────────────────────────────────
// Partnership Features
// ─────────────────────────────────────────────────────────────

model Partner {
  id    String  @id @default(cuid())
  name  String
  email String  @unique
  phone String?

  type String @default("FRANCHISE") // FRANCHISE, PARTNER, INVESTOR

  revenueSharePercent Decimal @default(0) @db.Decimal(5, 2)

  isActive   Boolean  @default(true)
  joinedDate DateTime @default(now())

  branches BranchPartner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partners")
}

model BranchPartner {
  id        String @id @default(cuid())
  branchId  String
  partnerId String

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([branchId, partnerId])
  @@index([branchId])
  @@index([partnerId])
  @@map("branch_partners")
}
