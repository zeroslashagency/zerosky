// zerosky — restaurant POS data model
// Multi-tenant (Tenant → Branch), menu → order → KOT → payment lifecycle.
// Studied from OSS workflows (URY, ahmedali5530, satisfecho, FloCafe);
// schema and names are original to zerosky.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum TableState {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILLED
  CLEANING
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  AGGREGATOR
}

enum OrderStatus {
  OPEN
  SENT_TO_KITCHEN
  READY
  SERVED
  BILLED
  PAID
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum KotStatus {
  NEW
  MODIFIED
  PARTIAL
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  AGGREGATOR
  COMPLIMENTARY
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  gstin     String? // GST registration number
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  users    User[]
  menus    Menu[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String // short code, unique per tenant
  address   String?
  phone     String?
  gstin     String?
  timezone  String   @default("Asia/Kolkata")
  currency  String   @default("INR")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables   Table[]
  orders   Order[]
  payments Payment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         UserRole @default(CASHIER)
  pin          String? // quick POS login PIN
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdOrders Order[] @relation("OrderCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Menu
// ─────────────────────────────────────────────────────────────

model Menu {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories Category[]

  @@index([tenantId])
  @@map("menus")
}

model Category {
  id        String   @id @default(cuid())
  menuId    String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu  Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items Item[]

  @@index([menuId])
  @@map("categories")
}

model Item {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  taxRate     Decimal  @default(5.0) @db.Decimal(5, 2) // GST %
  isVeg       Boolean  @default(true)
  sku         String?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@map("items")
}

model ModifierGroup {
  id        String   @id @default(cuid())
  itemId    String
  name      String // e.g. "Spice level", "Add-ons"
  minSelect Int      @default(0)
  maxSelect Int      @default(1)
  isRequired Boolean @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  modifiers Modifier[]

  @@index([itemId])
  @@map("modifier_groups")
}

model Modifier {
  id              String   @id @default(cuid())
  modifierGroupId String
  name            String
  price           Decimal  @default(0) @db.Decimal(10, 2)
  isDefault       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
  @@map("modifiers")
}

// ─────────────────────────────────────────────────────────────
// Floor
// ─────────────────────────────────────────────────────────────

model Table {
  id        String     @id @default(cuid())
  branchId  String
  name      String // "T1", "Patio 3"
  section   String? // "Main hall", "Rooftop"
  seats     Int        @default(4)
  state     TableState @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("tables")
}

// ─────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────

model Order {
  id           String      @id @default(cuid())
  branchId     String
  tableId      String?
  createdById  String?
  orderNumber  String // human-readable, unique per branch
  type         OrderType   @default(DINE_IN)
  status       OrderStatus @default(OPEN)
  guestCount   Int         @default(1)
  subtotal     Decimal     @default(0) @db.Decimal(10, 2)
  taxTotal     Decimal     @default(0) @db.Decimal(10, 2)
  discountTotal Decimal    @default(0) @db.Decimal(10, 2)
  grandTotal   Decimal     @default(0) @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table     Table?      @relation(fields: [tableId], references: [id])
  createdBy User?       @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items     OrderItem[]
  kots      Kot[]
  payments  Payment[]

  @@unique([branchId, orderNumber])
  @@index([branchId])
  @@index([tableId])
  @@index([createdById])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  itemId     String
  kotId      String?
  name       String // snapshot of item name at order time
  quantity   Int             @default(1)
  unitPrice  Decimal         @db.Decimal(10, 2)
  taxRate    Decimal         @db.Decimal(5, 2)
  lineTotal  Decimal         @db.Decimal(10, 2)
  seat       Int? // for seat-split billing
  modifiers  Json? // snapshot: [{ name, price }]
  notes      String?
  status     OrderItemStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item   @relation(fields: [itemId], references: [id])
  kot   Kot?   @relation(fields: [kotId], references: [id])

  @@index([orderId])
  @@index([itemId])
  @@index([kotId])
  @@map("order_items")
}

model Kot {
  id          String    @id @default(cuid())
  orderId     String
  kotNumber   String
  station     String? // "Tandoor", "Bar", "Cold kitchen"
  status      KotStatus @default(NEW)
  printedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@unique([orderId, kotNumber])
  @@index([orderId])
  @@index([status])
  @@map("kots")
}

// ─────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  branchId    String
  orderId     String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(10, 2)
  reference   String? // gateway txn id / UPI ref
  tenderedAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([orderId])
  @@map("payments")
}
